            class="w-full flex items-center justify-center gap-2.5 bg-forest-700 hover:bg-forest-800 disabled:opacity-50 disabled:cursor-not-allowed text-white font-semibold py-3.5 px-5 rounded-xl shadow-sm transition cursor-pointer"
          >
