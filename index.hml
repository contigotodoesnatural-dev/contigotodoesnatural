  <!-- 6 & 7. DRAWER CARRITO DE COMPRAS Y PEDIDO WHATSAPP -->
  <div id="cart-drawer" class="fixed inset-0 z-50 hidden justify-end bg-earth-900/60 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title">
    <div class="bg-cream w-full max-w-md h-full flex flex-col shadow-2xl border-l border-earth-200">
      
      <!-- Header Carrito -->
      <div class="px-6 py-4 bg-white border-b border-earth-200 flex items-center justify-between">
        <div>
          <h2 id="cart-drawer-title" class="font-serif text-xl font-bold text-earth-900">Tu Pedido</h2>
          <p class="text-xs text-earth-600">Calculado en Bolivianos (Bs)</p>
