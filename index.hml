  <!-- 10. MODAL DE ADMINISTRACIÓN BÁSICA (LocalStorage) -->
  <div id="admin-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-3 sm:p-6 bg-earth-900/70 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="admin-modal-title">
    <div class="bg-cream rounded-3xl max-w-4xl w-full max-h-[92vh] flex flex-col shadow-2xl border border-earth-200 overflow-hidden">
      
      <!-- Header Admin -->
      <div class="px-6 py-4 bg-white border-b border-earth-200 flex items-center justify-between gap-4">
        <div>
          <h2 id="admin-modal-title" class="font-serif text-xl font-bold text-earth-900">Administración Básica del Catálogo</h2>
          <p class="text-xs text-earth-600">Edita productos, precios en Bs, imágenes, categorías y disponibilidad.</p>
        </div>
        <button type="button" onclick="closeAdminModal()" class="p-2 rounded-xl text-earth-600 hover:bg-sand hover:text-earth-900 transition cursor-pointer" aria-label="Cerrar panel de administración">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Aviso Crítico de Almacenamiento Local -->
      <div class="bg-amber-50 border-b border-amber-200 px-6 py-3 text-xs text-amber-950 flex items-start gap-2.5">
        <svg class="w-4 h-4 text-amber-700 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <p>
          <strong>Almacenamiento local (solo demostración frontend):</strong> Los cambios realizados aquí se guardan únicamente en el navegador de este dispositivo (<code>localStorage</code>) y <strong>no se sincronizan automáticamente entre diferentes celulares o computadoras</strong>. Para publicar cambios permanentes para todos los clientes, exporta el JSON o actualiza los datos en el código fuente.
        </p>
      </div>

      <!-- Pestañas del Panel Admin -->
      <div class="px-6 pt-3 bg-sand/50 border-b border-earth-200 flex flex-wrap gap-2">
        <button type="button" id="tab-btn-products" onclick="switchAdminTab('products')" class="px-4 py-2 rounded-t-xl text-xs sm:text-sm font-semibold bg-cream text-forest-800 border-t border-x border-earth-200 cursor-pointer">
          Productos e Inventario
        </button>
        <button type="button" id="tab-btn-categories" onclick="switchAdminTab('categories')" class="px-4 py-2 rounded-t-xl text-xs sm:text-sm font-medium text-earth-600 hover:text-earth-900 cursor-pointer">
          Categorías
        </button>
        <button type="button" id="tab-btn-backup" onclick="switchAdminTab('backup')" class="px-4 py-2 rounded-t-xl text-xs sm:text-sm font-medium text-earth-600 hover:text-earth-900 cursor-pointer">
          Exportar / Restaurar Datos
        </button>
      </div>

      <!-- Cuerpo Admin Scrollable -->
      <div class="p-6 overflow-y-auto flex-1 space-y-6">
        
        <!-- TAB 1: PRODUCTOS -->
        <div id="admin-tab-products" class="space-y-6">
          <!-- Formulario Crear / Editar Producto -->
          <form id="admin-product-form" onsubmit="handleSaveProduct(event)" class="bg-white p-5 rounded-2xl border border-earth-200 space-y-4">
            <div class="flex items-center justify-between">
              <h3 id="admin-form-heading" class="font-serif text-base font-bold text-earth-900">Agregar nuevo producto</h3>
              <button type="button" id="cancel-edit-btn" onclick="resetProductForm()" class="hidden text-xs font-semibold text-earth-600 hover:text-earth-900 underline cursor-pointer">
                Cancelar edición
              </button>
            </div>

            <input type="hidden" id="prod-id" />

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              <div>
                <label for="prod-name" class="block text-xs font-semibold text-earth-800 mb-1">Nombre del producto *</label>
                <input type="text" id="prod-name" required placeholder="Ej. Jabón artesanal neutro" class="w-full px-3.5 py-2 bg-cream/60 border border-earth-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-forest-700" />
              </div>

              <div>
                <label for="prod-category" class="block text-xs font-semibold text-earth-800 mb-1">Categoría *</label>
                <select id="prod-category" required class="w-full px-3.5 py-2 bg-cream/60 border border-earth-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-forest-700">
                  <!-- Opciones dinámicas -->
                </select>
              </div>

              <div>
                <label for="prod-price" class="block text-xs font-semibold text-earth-800 mb-1">Precio en Bolivianos (Bs) *</label>
                <input type="number" id="prod-price" required min="0.5" step="0.5" placeholder="Ej. 35" class="w-full px-3.5 py-2 bg-cream/60 border border-earth-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-forest-700" />
              </div>

              <div>
                <label for="prod-availability" class="block text-xs font-semibold text-earth-800 mb-1">Disponibilidad *</label>
                <select id="prod-availability" class="w-full px-3.5 py-2 bg-cream/60 border border-earth-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-forest-700">
                  <option value="Disponible">Disponible</option>
                  <option value="Bajo pedido">Bajo pedido</option>
                  <option value="Agotado">Agotado</option>
                </select>
              </div>

              <div>
                <label for="prod-type" class="block text-xs font-semibold text-earth-800 mb-1">Etiqueta de registro *</label>
                <select id="prod-type" class="w-full px-3.5 py-2 bg-cream/60 border border-earth-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-forest-700">
                  <option value="demo">DEMOSTRACIÓN (Ejemplo)</option>
                  <option value="real">CATÁLOGO REAL (Confirmado)</option>
                </select>
              </div>

              <div>
                <label for="prod-image" class="block text-xs font-semibold text-earth-800 mb-1">URL de fotografía</label>
                <input type="url" id="prod-image" placeholder="https://..." class="w-full px-3.5 py-2 bg-cream/60 border border-earth-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-forest-700" />
              </div>
            </div>

            <div>
              <label for="prod-desc" class="block text-xs font-semibold text-earth-800 mb-1">Descripción breve *</label>
              <textarea id="prod-desc" rows="2" required placeholder="Describe presentación, peso o materiales (evita afirmaciones médicas)." class="w-full px-3.5 py-2 bg-cream/60 border border-earth-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-forest-700"></textarea>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
              <p class="text-[11px] text-earth-600">Si dejas la URL de imagen vacía, se asignará una imagen referencial automática.</p>
              <button type="submit" class="bg-forest-700 hover:bg-forest-800 text-white text-xs sm:text-sm font-semibold px-5 py-2.5 rounded-xl transition cursor-pointer">
                Guardar producto
              </button>
            </div>
          </form>

          <!-- Listado Editable de Productos -->
          <div class="space-y-3">
            <h3 class="font-serif text-base font-bold text-earth-900">Inventario actual en este navegador</h3>
            <div id="admin-products-list" class="divide-y divide-earth-200 bg-white rounded-2xl border border-earth-200 overflow-hidden">
              <!-- Renderizado por JS -->
            </div>
          </div>
        </div>

        <!-- TAB 2: CATEGORÍAS -->
        <div id="admin-tab-categories" class="hidden space-y-5">
          <div class="bg-white p-5 rounded-2xl border border-earth-200 space-y-4">
            <h3 class="font-serif text-base font-bold text-earth-900">Gestionar Categorías</h3>
            <p class="text-xs text-earth-600">Crea o elimina categorías para organizar tus productos naturales y artesanales.</p>
            <form onsubmit="handleAddCategory(event)" class="flex flex-col sm:flex-row gap-3">
              <label for="new-category-input" class="sr-only">Nombre de nueva categoría</label>
              <input type="text" id="new-category-input" required placeholder="Ej. Cosmética Artesanal" class="flex-1 px-4 py-2.5 bg-cream/60 border border-earth-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-forest-700" />
              <button type="submit" class="bg-forest-700 hover:bg-forest-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition cursor-pointer">
                Agregar categoría
              </button>
            </form>
          </div>

          <div id="admin-categories-list" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <!-- Renderizado por JS -->
          </div>
        </div>

        <!-- TAB 3: EXPORTAR / RESTAURAR -->
        <div id="admin-tab-backup" class="hidden space-y-5">
          <div class="bg-white p-5 rounded-2xl border border-earth-200 space-y-4">
            <h3 class="font-serif text-base font-bold text-earth-900">Respaldo y Transferencia de Datos</h3>
            <p class="text-xs text-earth-600 leading-relaxed">
              Como esta aplicación funciona sin base de datos externa, puedes copiar la configuración actual en formato JSON para respaldar tu inventario, o pegar un respaldo JSON previo para cargarlo en este navegador.
            </p>
            <div class="flex flex-wrap gap-2.5">
              <button type="button" onclick="exportCatalogJSON()" class="bg-forest-700 hover:bg-forest-800 text-white text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-xl transition cursor-pointer">
                Copiar JSON del catálogo
              </button>
              <button type="button" onclick="importCatalogJSON()" class="bg-sand hover:bg-earth-200 text-earth-900 border border-earth-200 text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-xl transition cursor-pointer">
                Cargar JSON pegado
              </button>
              <button type="button" onclick="requestResetDemoData()" class="bg-red-50 hover:bg-red-100 text-red-800 border border-red-200 text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-xl transition cursor-pointer">
                Restaurar ejemplos de demostración
              </button>
            </div>
            <div>
              <label for="json-output" class="block text-xs font-semibold text-earth-800 mb-1">Estructura de datos (JSON editable para importar/exportar):</label>
              <textarea id="json-output" rows="8" class="w-full p-3 bg-cream border border-earth-200 rounded-xl font-mono text-xs text-earth-800 focus:outline-none focus:ring-2 focus:ring-forest-700"></textarea>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- MODAL DE CONFIRMACIÓN PERSONALIZADO (Reemplaza window.confirm) -->
  <div id="confirm-modal" class="fixed inset-0 z-[60] hidden items-center justify-center p-4 bg-earth-900/70 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="confirm-modal-title">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-xl border border-earth-200 space-y-4">
      <h3 id="confirm-modal-title" class="font-serif text-lg font-bold text-earth-900">Confirmar acción</h3>
      <p id="confirm-modal-text" class="text-sm text-earth-600">¿Estás seguro de continuar?</p>
      <div class="flex items-center justify-end gap-3 pt-2">
        <button type="button" onclick="closeConfirmModal()" class="px-4 py-2 rounded-xl text-sm font-medium text-earth-700 bg-sand hover:bg-earth-200 transition cursor-pointer">
          Cancelar
        </button>
        <button type="button" id="confirm-modal-accept" class="px-4 py-2 rounded-xl text-sm font-semibold text-white bg-red-700 hover:bg-red-800 transition cursor-pointer">
          Confirmar
        </button>
      </div>
    </div>
  </div>

  <!-- NOTIFICACIÓN TOAST ACCESIBLE (Reemplaza window.alert) -->
  <div id="toast-container" class="fixed bottom-20 sm:bottom-6 left-1/2 -translate-x-1/2 z-[70] pointer-events-none flex flex-col items-center gap-2 w-full max-w-sm px-4" aria-live="polite"></div>

  <!-- LÓGICA DE LA APLICACIÓN -->
  <script>
    /**
     * CONFIGURACIÓN OFICIAL DEL NEGOCIO
     * Datos verificados proporcionados por el propietario.
     */
    const BUSINESS_CONFIG = {
      name: 'Contigo Todo es Natural',
      activity: 'Venta de productos naturales y artesanales',
      city: 'Santa Cruz de la Sierra, Bolivia',
      whatsappNumber: '59162303765',
      whatsappDisplay: '+591 62303765',
      currency: 'Bs'
    };

    const STORAGE_KEYS = {
      PRODUCTS: 'cten_products_v1',
      CATEGORIES: 'cten_categories_v1',
      CART: 'cten_cart_v1'
    };

    /**
     * DATOS INICIALES DE DEMOSTRACIÓN
     * Claramente identificados como DEMOSTRACIÓN (isDemo: true) y 100% editables.
     * Sin afirmaciones medicinales ni certificaciones inventadas.
     */
    const DEFAULT_CATEGORIES = [
      'Cuidado Personal Artesanal',
      'Alimentos Naturales',
      'Infusiones y Hierbas',
      'Hogar y Aromas'
    ];

    const DEFAULT_PRODUCTS = [
      {
        id: 'demo-1',
        name: 'Jabón Artesanal de Avena (Ejemplo)',
        category: 'Cuidado Personal Artesanal',
        price: 25.00,
        availability: 'Disponible',
        isDemo: true,
        image: 'https://images.unsplash.com/photo-1600857544200-b2f666a9a2ec?auto=format&fit=crop&w=700&q=80',
        description: 'Registro de demostración editable. Barra artesanal elaborada en lotes pequeños con textura suave para el cuidado diario.'
      },
      {
        id: 'demo-2',
        name: 'Miel Cruda Multifloral 500g (Ejemplo)',
        category: 'Alimentos Naturales',
        price: 45.00,
        availability: 'Disponible',
        isDemo: true,
        image: 'https://images.unsplash.com/photo-1587049352846-4a222e784d38?auto=format&fit=crop&w=700&q=80',
        description: 'Registro de demostración editable. Presentación en frasco de vidrio reutilizable de 500 gramos.'
      },
      {
        id: 'demo-3',
        name: 'Mezcla de Hierbas Aromáticas (Ejemplo)',
        category: 'Infusiones y Hierbas',
        price: 30.00,
        availability: 'Disponible',
        isDemo: true,
        image: 'https://images.unsplash.com/photo-1564890369478-c89ca6d9cde9?auto=format&fit=crop&w=700&q=80',
        description: 'Registro de demostración editable. Selección de hojas secas aromáticas en bolsa kraft sellada.'
      },
      {
        id: 'demo-4',
        name: 'Vela Artesanal de Cera Natural (Ejemplo)',
        category: 'Hogar y Aromas',
        price: 55.00,
        availability: 'Bajo pedido',
        isDemo: true,
        image: 'https://images.unsplash.com/photo-1603006905003-be475563bc59?auto=format&fit=crop&w=700&q=80',
        description: 'Registro de demostración editable. Vertida a mano en envase artesanal para ambientar espacios del hogar.'
      },
      {
        id: 'demo-5',
        name: 'Exfoliante Corporal Artesanal (Ejemplo)',
        category: 'Cuidado Personal Artesanal',
        price: 40.00,
        availability: 'Disponible',
        isDemo: true,
        image: 'https://images.unsplash.com/photo-1556228578-0d85b1a4d571?auto=format&fit=crop&w=700&q=80',
        description: 'Registro de demostración editable. Textura granulada natural en presentación de 200 gramos.'
      },
      {
        id: 'demo-6',
        name: 'Granola Artesanal con Semillas (Ejemplo)',
        category: 'Alimentos Naturales',
        price: 35.00,
        availability: 'Agotado',
        isDemo: true,
        image: 'https://images.unsplash.com/photo-1517673132405-a56a62b18caf?auto=format&fit=crop&w=700&q=80',
        description: 'Registro de demostración editable. Ejemplo de artículo marcado como agotado para visualizar estados de disponibilidad.'
      }
    ];

    // Estado Global de la Aplicación
    let state = {
      products: [],
      categories: [],
      cart: [],
      filters: {
        search: '',
        category: 'Todas',
        minPrice: '',
        maxPrice: ''
      },
      pendingConfirmCallback: null
    };

    /**
     * Inicialización al cargar el DOM
     */
    document.addEventListener('DOMContentLoaded', () => {
      loadStateFromStorage();
      bindFilterEvents();
      renderAll();
    });

    function loadStateFromStorage() {
      try {
        const savedCategories = localStorage.getItem(STORAGE_KEYS.CATEGORIES);
        const savedProducts = localStorage.getItem(STORAGE_KEYS.PRODUCTS);
        const savedCart = localStorage.getItem(STORAGE_KEYS.CART);

        state.categories = savedCategories ? JSON.parse(savedCategories) : [...DEFAULT_CATEGORIES];
        state.products = savedProducts ? JSON.parse(savedProducts) : [...DEFAULT_PRODUCTS];
        state.cart = savedCart ? JSON.parse(savedCart) : [];
      } catch (error) {
        console.error('Error leyendo almacenamiento local:', error);
        state.categories = [...DEFAULT_CATEGORIES];
        state.products = [...DEFAULT_PRODUCTS];
        state.cart = [];
      }
    }

    function saveStateToStorage() {
      try {
        localStorage.setItem(STORAGE_KEYS.CATEGORIES, JSON.stringify(state.categories));
        localStorage.setItem(STORAGE_KEYS.PRODUCTS, JSON.stringify(state.products));
        localStorage.setItem(STORAGE_KEYS.CART, JSON.stringify(state.cart));
      } catch (error) {
        console.error('Error guardando en almacenamiento local:', error);
        showToast('No se pudo guardar en el almacenamiento local del navegador.', 'error');
      }
    }

    function renderAll() {
      renderCategories();
      renderProducts();
      updateCartUI();
      updateDemoBannerVisibility();
    }

    /**
     * Formateo consistente de moneda Bolivianos (Bs)
     */
    function formatBs(amount) {
      const num = Number(amount) || 0;
      return `${BUSINESS_CONFIG.currency} ${num.toFixed(2)}`;
    }

    /**
     * Escapado seguro de HTML para evitar inyección al editar campos
     */
    function escapeHTML(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    /**
     * Construye enlace oficial de WhatsApp con mensaje codificado
     */
    function buildWhatsAppURL(message) {
      return `https://wa.me/${BUSINESS_CONFIG.whatsappNumber}?text=${encodeURIComponent(message)}`;
    }

    function updateDemoBannerVisibility() {
      const hasDemoItems = state.products.some(p => p.isDemo);
      const banner = document.getElementById('demo-notice-banner');
      if (banner) {
        banner.classList.toggle('hidden', !hasDemoItems);
      }
    }

    /**
     * Renderizado de Categorías (Pills + Selects)
     */
    function renderCategories() {
      const pillsContainer = document.getElementById('category-pills');
      const filterSelect = document.getElementById('category-select');
      const adminSelect = document.getElementById('prod-category');

      const allCategories = ['Todas', ...state.categories];

      // Pills
      pillsContainer.innerHTML = allCategories.map(cat => {
        const isActive = state.filters.category === cat;
        const activeClasses = isActive
          ? 'bg-forest-700 text-white border-forest-700 shadow-xs'
          : 'bg-white text-earth-800 border-earth-200 hover:bg-sand';
        return `
          <button
            type="button"
            role="tab"
            aria-selected="${isActive}"
            onclick="selectCategory('${escapeHTML(cat)}')"
            class="px-4 py-2 rounded-xl text-xs sm:text-sm font-medium border transition cursor-pointer ${activeClasses}"
          >
            ${escapeHTML(cat)}
          </button>
        `;
      }).join('');

      // Select filtro
      filterSelect.innerHTML = allCategories.map(cat => `
        <option value="${escapeHTML(cat)}" ${state.filters.category === cat ? 'selected' : ''}>
          ${escapeHTML(cat)}
        </option>
      `).join('');

      // Select formulario admin
      if (adminSelect) {
        adminSelect.innerHTML = state.categories.map(cat => `
          <option value="${escapeHTML(cat)}">${escapeHTML(cat)}</option>
        `).join('');
      }
    }

    function selectCategory(category) {
      state.filters.category = category;
      renderCategories();
      renderProducts();
    }

    function bindFilterEvents() {
      const searchInput = document.getElementById('search-input');
      const categorySelect = document.getElementById('category-select');
      const minPriceInput = document.getElementById('min-price');
      const maxPriceInput = document.getElementById('max-price');

      searchInput.addEventListener('input', (e) => {
        state.filters.search = e.target.value.trim().toLowerCase();
        renderProducts();
      });

      categorySelect.addEventListener('change', (e) => {
        selectCategory(e.target.value);
      });

      minPriceInput.addEventListener('input', (e) => {
        state.filters.minPrice = e.target.value;
        renderProducts();
      });

      maxPriceInput.addEventListener('input', (e) => {
        state.filters.maxPrice = e.target.value;
        renderProducts();
      });
    }

    function resetFilters() {
      state.filters = { search: '', category: 'Todas', minPrice: '', maxPrice: '' };
      document.getElementById('search-input').value = '';
      document.getElementById('min-price').value = '';
      document.getElementById('max-price').value = '';
      renderCategories();
      renderProducts();
    }

    /**
     * Filtrado y Renderizado de Tarjetas de Productos
     */
    function getFilteredProducts() {
      return state.products.filter(product => {
        // Filtro por categoría
        if (state.filters.category !== 'Todas' && product.category !== state.filters.category) {
          return false;
        }
        // Filtro por búsqueda (nombre o descripción)
        if (state.filters.search) {
          const query = state.filters.search;
          const matchName = product.name.toLowerCase().includes(query);
          const matchDesc = product.description.toLowerCase().includes(query);
          if (!matchName && !matchDesc) return false;
        }
        // Filtro por precio mínimo
        if (state.filters.minPrice !== '' && !isNaN(Number(state.filters.minPrice))) {
          if (Number(product.price) < Number(state.filters.minPrice)) return false;
        }
        // Filtro por precio máximo
        if (state.filters.maxPrice !== '' && !isNaN(Number(state.filters.maxPrice))) {
          if (Number(product.price) > Number(state.filters.maxPrice)) return false;
        }
        return true;
      });
    }

    function getAvailabilityBadge(status) {
      if (status === 'Disponible') {
        return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-forest-100 text-forest-800"><span class="w-1.5 h-1.5 rounded-full bg-forest-600"></span>Disponible</span>`;
      }
      if (status === 'Bajo pedido') {
        return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-900"><span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>Bajo pedido</span>`;
      }
      return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-stone-200 text-stone-700"><span class="w-1.5 h-1.5 rounded-full bg-stone-500"></span>Agotado</span>`;
    }

    function renderProducts() {
      const grid = document.getElementById('products-grid');
      const emptyState = document.getElementById('empty-state');
      const counter = document.getElementById('results-counter');

      const filtered = getFilteredProducts();
      counter.textContent = `Mostrando ${filtered.length} de ${state.products.length} productos`;

      if (filtered.length === 0) {
        grid.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');

      grid.innerHTML = filtered.map(product => {
        const isOutOfStock = product.availability === 'Agotado';
        const singleWaMessage = `Hola *${BUSINESS_CONFIG.name}* 🌿, me gustaría consultar por este producto:\n• *${product.name}* (${formatBs(product.price)})\n¿Tienen disponibilidad?`;
        const waLink = buildWhatsAppURL(singleWaMessage);
        const safeImg = product.image || 'https://placehold.co/600x450/E7DFD3/2D4F3E?text=Producto+Natural';

        return `
          <article class="bg-white rounded-3xl border border-earth-200/80 shadow-xs hover:shadow-md transition flex flex-col overflow-hidden group">
            <!-- Imagen con etiquetas -->
            <div class="relative aspect-[4/3] bg-sand overflow-hidden">
              <button type="button" onclick="openProductModal('${escapeHTML(product.id)}')" class="w-full h-full block text-left focus:outline-none cursor-pointer" aria-label="Ver detalle de ${escapeHTML(product.name)}">
                <img
                  src="${escapeHTML(safeImg)}"
                  alt="${escapeHTML(product.name)}"
                  onerror="this.onerror=null; this.src='https://placehold.co/600x450/E7DFD3/2D4F3E?text=Contigo+Todo+es+Natural';"
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-500 ${isOutOfStock ? 'opacity-65 grayscale-[30%]' : ''}"
                />
              </button>

              <!-- Etiqueta Demostración vs Real -->
              <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                ${product.isDemo
                  ? `<span class="bg-amber-100/95 text-amber-950 border border-amber-300 text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-lg shadow-xs">Demostración</span>`
                  : `<span class="bg-forest-700/95 text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-lg shadow-xs">Catálogo</span>`
                }
              </div>

              <div class="absolute top-3 right-3">
                ${getAvailabilityBadge(product.availability)}
              </div>
            </div>

            <!-- Contenido de la Tarjeta -->
            <div class="p-5 flex-1 flex flex-col">
              <div class="text-xs font-medium text-terracotta-600 mb-1">${escapeHTML(product.category)}</div>
              <h3 class="font-serif text-lg font-bold text-earth-900 leading-snug">
                <button type="button" onclick="openProductModal('${escapeHTML(product.id)}')" class="text-left hover:text-forest-700 transition cursor-pointer">
                  ${escapeHTML(product.name)}
                </button>
              </h3>

              <p class="text-sm text-earth-600 mt-2 line-clamp-2 flex-1">
                ${escapeHTML(product.description)}
              </p>

              <!-- Precio y Acciones -->
              <div class="pt-4 mt-4 border-t border-earth-100 space-y-3">
                <div class="flex items-center justify-between">
                  <div>
                    <span class="text-[11px] text-earth-600 block">Precio referencial</span>
                    <span class="text-xl font-bold text-forest-800">${formatBs(product.price)}</span>
                  </div>
                  <button
                    type="button"
                    onclick="openProductModal('${escapeHTML(product.id)}')"
                    class="text-xs font-semibold text-earth-700 hover:text-forest-800 underline px-2 py-1.5 cursor-pointer"
                  >
                    Ver ficha
                  </button>
                </div>

                <div class="grid grid-cols-2 gap-2">
                  <button
                    type="button"
                    onclick="addToCart('${escapeHTML(product.id)}', 1)"
                    ${isOutOfStock ? 'disabled' : ''}
                    class="inline-flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl text-xs font-semibold transition ${
                      isOutOfStock
                        ? 'bg-stone-100 text-stone-400 cursor-not-allowed'
                        : 'bg-forest-700 hover:bg-forest-800 text-white shadow-xs cursor-pointer'
                    }"
                  >
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                    </svg>
                    <span>${isOutOfStock ? 'Agotado' : 'Agregar'}</span>
                  </button>

                  <a
                    href="${waLink}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl text-xs font-semibold bg-sand hover:bg-earth-200/80 text-forest-800 border border-earth-200 transition text-center"
                  >
                    <svg class="w-4 h-4 text-forest-700 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z"/>
                    </svg>
                    <span>Consultar</span>
                  </a>
                </div>
              </div>
            </div>
          </article>
        `;
      }).join('');
    }

    /**
     * 5. DETALLE DEL PRODUCTO (Modal con disponibilidad editable rápida y selector de cantidad)
     */
    function openProductModal(productId) {
      const product = state.products.find(p => p.id === productId);
      if (!product) return;

      const modal = document.getElementById('product-modal');
      const content = document.getElementById('product-modal-content');
      const isOutOfStock = product.availability === 'Agotado';
      const safeImg = product.image || 'https://placehold.co/600x450/E7DFD3/2D4F3E?text=Producto+Natural';

      const singleWaMessage = `Hola *${BUSINESS_CONFIG.name}* 🌿, quisiera más información sobre:\n• *${product.name}*\n• Precio: ${formatBs(product.price)}\n• Estado mostrado: ${product.availability}`;

      content.innerHTML = `
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-start">
          <div class="sm:col-span-5 rounded-2xl overflow-hidden bg-sand border border-earth-200 aspect-square">
            <img
              src="${escapeHTML(safeImg)}"
              alt="${escapeHTML(product.name)}"
              onerror="this.onerror=null; this.src='https://placehold.co/600x450/E7DFD3/2D4F3E?text=Contigo+Todo+es+Natural';"
              class="w-full h-full object-cover"
            />
          </div>

          <div class="sm:col-span-7 space-y-4">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-semibold text-terracotta-600">${escapeHTML(product.category)}</span>
              ${product.isDemo
                ? `<span class="bg-amber-100 text-amber-950 border border-amber-300 text-[10px] font-bold uppercase px-2 py-0.5 rounded-md">Registro de Demostración</span>`
                : `<span class="bg-forest-100 text-forest-800 text-[10px] font-bold uppercase px-2 py-0.5 rounded-md">Catálogo</span>`
              }
            </div>

            <h2 id="modal-product-title" class="font-serif text-2xl font-bold text-earth-900 leading-tight">
              ${escapeHTML(product.name)}
            </h2>

            <div class="text-2xl font-bold text-forest-800">
              ${formatBs(product.price)}
            </div>

            <p class="text-sm text-earth-700 leading-relaxed">
              ${escapeHTML(product.description)}
            </p>

            <!-- Disponibilidad Editable -->
            <div class="bg-sand/70 p-3.5 rounded-xl border border-earth-200/80 space-y-1.5">
              <div class="flex items-center justify-between gap-2">
                <label for="modal-availability-select" class="text-xs font-semibold text-earth-800">Estado de disponibilidad (editable):</label>
                ${getAvailabilityBadge(product.availability)}
              </div>
              <select
                id="modal-availability-select"
                onchange="updateProductAvailability('${escapeHTML(product.id)}', this.value)"
                class="w-full mt-1 px-3 py-2 bg-white border border-earth-200 rounded-lg text-xs font-medium text-earth-900 focus:outline-none focus:ring-2 focus:ring-forest-700"
              >
                <option value="Disponible" ${product.availability === 'Disponible' ? 'selected' : ''}>Disponible</option>
                <option value="Bajo pedido" ${product.availability === 'Bajo pedido' ? 'selected' : ''}>Bajo pedido</option>
                <option value="Agotado" ${product.availability === 'Agotado' ? 'selected' : ''}>Agotado</option>
              </select>
            </div>

            <!-- Selector de Cantidad y Botones -->
            <div class="pt-2 space-y-3">
              <div class="flex items-center gap-3">
                <label for="modal-qty-input" class="text-xs font-semibold text-earth-800">Cantidad:</label>
                <div class="inline-flex items-center border border-earth-200 rounded-xl bg-white overflow-hidden">
                  <button type="button" onclick="adjustModalQty(-1)" class="px-3 py-2 text-earth-800 hover:bg-sand font-bold cursor-pointer" aria-label="Disminuir cantidad">-</button>
                  <input type="number" id="modal-qty-input" value="1" min="1" max="99" class="w-12 text-center text-sm font-semibold text-earth-900 focus:outline-none" />
                  <button type="button" onclick="adjustModalQty(1)" class="px-3 py-2 text-earth-800 hover:bg-sand font-bold cursor-pointer" aria-label="Aumentar cantidad">+</button>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row gap-2.5">
                <button
                  type="button"
                  onclick="addFromModal('${escapeHTML(product.id)}')"
                  ${isOutOfStock ? 'disabled' : ''}
                  class="flex-1 inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-semibold transition ${
                    isOutOfStock
                      ? 'bg-stone-200 text-stone-500 cursor-not-allowed'
                      : 'bg-forest-700 hover:bg-forest-800 text-white shadow-sm cursor-pointer'
                  }"
                >
                  <span>${isOutOfStock ? 'Producto Agotado' : 'Agregar al pedido'}</span>
                </button>

                <a
                  href="${buildWhatsAppURL(singleWaMessage)}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-semibold bg-white hover:bg-sand text-forest-800 border border-forest-700/30 transition text-center"
                >
                  <span>Consultar por WhatsApp</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      `;

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeProductModal() {
      const modal = document.getElementById('product-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function adjustModalQty(delta) {
      const input = document.getElementById('modal-qty-input');
      if (!input) return;
      let val = parseInt(input.value, 10) || 1;
      val = Math.min(99, Math.max(1, val + delta));
      input.value = val;
    }

    function addFromModal(productId) {
      const input = document.getElementById('modal-qty-input');
      const qty = Math.min(99, Math.max(1, parseInt(input?.value, 10) || 1));
      addToCart(productId, qty);
      closeProductModal();
    }

    function updateProductAvailability(productId, newStatus) {
      const idx = state.products.findIndex(p => p.id === productId);
      if (idx === -1) return;
      state.products[idx].availability = newStatus;
      saveStateToStorage();
      renderProducts();
      openProductModal(productId);
      showToast(`Disponibilidad actualizada a "${newStatus}"`, 'success');
    }

    /**
     * 6. CARRITO DE COMPRAS (Cálculo en Bs, validación de cantidades)
     */
    function addToCart(productId, quantity = 1) {
      const product = state.products.find(p => p.id === productId);
      if (!product) return;

      if (product.availability === 'Agotado') {
        showToast('Este producto figura como agotado actualmente.', 'error');
        return;
      }

      const validQty = Math.min(99, Math.max(1, parseInt(quantity, 10) || 1));
      const existingItem = state.cart.find(item => item.productId === productId);

      if (existingItem) {
        existingItem.quantity = Math.min(99, existingItem.quantity + validQty);
      } else {
        state.cart.push({
          productId: product.id,
          quantity: validQty
        });
      }

      saveStateToStorage();
      updateCartUI();
      showToast(`"${product.name}" agregado a tu pedido`, 'success');
    }

    function updateCartQuantity(productId, delta) {
      const itemIndex = state.cart.findIndex(i => i.productId === productId);
      if (itemIndex === -1) return;

      const newQty = state.cart[itemIndex].quantity + delta;
      if (newQty <= 0) {
        removeFromCart(productId);
        return;
      }
      state.cart[itemIndex].quantity = Math.min(99, newQty);
      saveStateToStorage();
      updateCartUI();
    }

    function removeFromCart(productId) {
      state.cart = state.cart.filter(item => item.productId !== productId);
      saveStateToStorage();
      updateCartUI();
    }

    function requestClearCart() {
      if (state.cart.length === 0) return;
      openConfirmModal(
        'Vaciar lista de pedido',
        '¿Deseas retirar todos los productos seleccionados de tu pedido?',
        () => {
          state.cart = [];
          saveStateToStorage();
          updateCartUI();
          showToast('Lista de pedido vaciada', 'info');
        }
      );
    }

    function calculateCartTotals() {
      let totalItems = 0;
      let subtotal = 0;
      const detailedItems = [];

      state.cart.forEach(cartItem => {
        const product = state.products.find(p => p.id === cartItem.productId);
        if (product) {
          const lineTotal = Number(product.price) * cartItem.quantity;
          totalItems += cartItem.quantity;
          subtotal += lineTotal;
          detailedItems.push({
            product,
            quantity: cartItem.quantity,
            lineTotal
          });
        }
      });

      return { totalItems, subtotal, detailedItems };
    }

    function updateCartUI() {
      const { totalItems, subtotal, detailedItems } = calculateCartTotals();
      const badge = document.getElementById('cart-badge');
      const container = document.getElementById('cart-items-container');
      const subtotalEl = document.getElementById('cart-subtotal');
      const checkoutBtn = document.getElementById('whatsapp-checkout-btn');
      const mobileStickyBar = document.getElementById('mobile-sticky-cart');
      const mobileStickyCount = document.getElementById('mobile-sticky-count');
      const mobileStickySubtotal = document.getElementById('mobile-sticky-subtotal');
      const floatingWaBtn = document.getElementById('floating-whatsapp-btn');

      badge.textContent = totalItems;
      subtotalEl.textContent = formatBs(subtotal);
      checkoutBtn.disabled = detailedItems.length === 0;

      if (mobileStickyBar && mobileStickyCount && mobileStickySubtotal) {
        if (detailedItems.length > 0) {
          mobileStickyBar.classList.remove('hidden');
          mobileStickyCount.textContent = `${totalItems} producto(s) en tu pedido`;
          mobileStickySubtotal.textContent = formatBs(subtotal);
          if (floatingWaBtn) floatingWaBtn.classList.add('bottom-20', 'sm:bottom-5');
        } else {
          mobileStickyBar.classList.add('hidden');
          if (floatingWaBtn) floatingWaBtn.classList.remove('bottom-20', 'sm:bottom-5');
        }
      }

      if (detailedItems.length === 0) {
// ... existing code ... -->
    function exportCatalogJSON() {
      updateJsonPreview();
      const textarea = document.getElementById('json-output');
      textarea.select();
      try {
        document.execCommand('copy');
        showToast('Estructura JSON copiada al portapapeles', 'success');
      } catch (e) {
        showToast('Selecciona el texto del recuadro para copiarlo manualmente', 'info');
      }
    }

    function importCatalogJSON() {
      const textarea = document.getElementById('json-output');
      if (!textarea) return;
      try {
        const parsed = JSON.parse(textarea.value);
        if (!Array.isArray(parsed.categories) || !Array.isArray(parsed.products) || parsed.categories.length === 0) {
          showToast('El formato JSON debe contener listas válidas de "categories" y "products".', 'error');
          return;
        }
        state.categories = parsed.categories.map(c => String(c).trim()).filter(Boolean);
        state.products = parsed.products.map((p, idx) => ({
          id: String(p.id || `prod-${Date.now()}-${idx}`),
          name: String(p.name || 'Producto sin nombre'),
          category: state.categories.includes(p.category) ? p.category : state.categories[0],
          price: Math.max(0.5, Number(p.price) || 10),
          availability: ['Disponible', 'Bajo pedido', 'Agotado'].includes(p.availability) ? p.availability : 'Disponible',
          isDemo: Boolean(p.isDemo),
          image: String(p.image || 'https://placehold.co/600x450/E7DFD3/2D4F3E?text=Producto+Natural'),
          description: String(p.description || '')
        }));
        state.cart = [];
        saveStateToStorage();
        renderAll();
        renderAdminProductsList();
        renderAdminCategoriesList();
        showToast('Inventario JSON cargado correctamente en este navegador', 'success');
      } catch (err) {
        showToast('JSON inválido. Verifica la sintaxis antes de importar.', 'error');
      }
    }

    function requestResetDemoData() {
