          <input
            type="text"
            id="order-note"
            placeholder="Ej. Entrega cerca del 2do anillo..."
            class="w-full px-3.5 py-2 bg-cream/70 border border-earth-200 rounded-xl text-xs text-earth-900 focus:outline-none focus:ring-2 focus:ring-forest-700"
          />
