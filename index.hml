<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contigo Todo es Natural | Productos Naturales y Artesanales en Santa Cruz</title>
  <meta name="description" content="Venta de productos naturales y artesanales en Santa Cruz de la Sierra, Bolivia. Explora nuestro catálogo y realiza tu pedido directamente por WhatsApp." />

  <!-- Tipografías Google Fonts: Lora (editorial/artesanal) e Inter (legibilidad UI) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            serif: ['Lora', 'Georgia', 'serif'],
          },
          colors: {
            cream: '#FAF7F2',
            sand: '#F1EAE0',
            earth: {
              100: '#E7DFD3',
              200: '#D4C7B4',
              600: '#6E5D4F',
              800: '#3E352E',
              900: '#26211D',
            },
            forest: {
              50: '#F2F6F3',
              100: '#E0EBE3',
              600: '#3A6650',
              700: '#2D4F3E',
              800: '#213B2E',
            },
            terracotta: {
              500: '#C4744B',
              600: '#B06139',
            }
          }
        }
      }
    };
  </script>
</head>
<body class="bg-cream text-earth-900 font-sans antialiased selection:bg-forest-700 selection:text-white flex flex-col min-h-screen">

  <!-- Barra superior informativa (Ubicación y Canal Oficial) -->
  <div class="bg-forest-800 text-cream text-xs sm:text-sm py-2 px-4">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-earth-200 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>Santa Cruz de la Sierra, Bolivia</span>
      </div>
      <div class="flex items-center gap-4">
        <span class="hidden sm:inline text-earth-200">Pedidos directos por WhatsApp:</span>
        <a href="https://wa.me/59162303765?text=Hola%20Contigo%20Todo%20es%20Natural%2C%20quisiera%20hacer%20una%20consulta." target="_blank" rel="noopener noreferrer" class="font-medium underline decoration-earth-200/60 hover:text-white transition">
          +591 62303765
        </a>
      </div>
    </div>
  </div>

  <!-- Encabezado Principal Sticky -->
  <header class="sticky top-0 z-40 bg-cream/95 backdrop-blur-md border-b border-earth-100 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-4">
      
      <!-- Encabezado Tipográfico (Sin logotipo oficial inventado) -->
      <a href="#inicio" class="flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-forest-700 rounded-lg p-1" aria-label="Inicio - Contigo Todo es Natural">
        <span class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-forest-700 text-cream flex items-center justify-center shrink-0 shadow-sm group-hover:bg-forest-800 transition" aria-hidden="true">
          <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c-4.5-3.5-7-7.5-7-11.5C5 5.5 8 3 12 3s7 2.5 7 6.5c0 4-2.5 8-7 11.5z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21V9m0 4l3-3m-3 6l-3-3" />
          </svg>
        </span>
        <div class="flex flex-col">
          <span class="font-serif font-bold text-lg sm:text-xl leading-tight text-forest-800 tracking-tight">Contigo</span>
          <span class="text-[10px] sm:text-xs font-semibold uppercase tracking-[0.18em] text-earth-600">Todo es Natural</span>
        </div>
      </a>

      <!-- Navegación Desktop -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-earth-800" aria-label="Navegación principal">
        <a href="#inicio" class="hover:text-forest-700 transition py-2">Inicio</a>
        <a href="#catalogo" class="hover:text-forest-700 transition py-2">Catálogo</a>
        <a href="#nosotros" class="hover:text-forest-700 transition py-2">Sobre Nosotros</a>
        <a href="#contacto" class="hover:text-forest-700 transition py-2">Contacto</a>
        <button type="button" onclick="openAdminModal()" class="inline-flex items-center gap-1.5 text-earth-600 hover:text-forest-700 bg-sand/80 hover:bg-sand px-3 py-1.5 rounded-lg border border-earth-200/70 transition cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>Administrar</span>
        </button>
      </nav>

      <!-- Acciones Derecha: Carrito + Menú Móvil -->
      <div class="flex items-center gap-2 sm:gap-3">
        <button type="button" onclick="openCartDrawer()" class="relative inline-flex items-center gap-2 bg-forest-700 hover:bg-forest-800 text-white px-3.5 py-2.5 rounded-xl text-sm font-medium shadow-sm transition cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-forest-700" aria-label="Abrir carrito de pedidos">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="hidden sm:inline">Pedido</span>
          <span id="cart-badge" class="bg-terracotta-500 text-white text-xs font-bold px-2 py-0.5 rounded-full min-w-[1.5rem] text-center">0</span>
        </button>

        <!-- Botón Menú Móvil -->
        <button type="button" id="mobile-menu-btn" onclick="toggleMobileMenu()" class="md:hidden p-2.5 rounded-xl text-earth-800 hover:bg-sand border border-earth-200 transition cursor-pointer" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú de navegación">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Menú Desplegable Móvil -->
    <div id="mobile-menu" class="hidden md:hidden bg-cream border-t border-earth-100 px-4 pt-3 pb-5 space-y-2 shadow-lg">
      <a href="#inicio" onclick="closeMobileMenu()" class="block px-3 py-2.5 rounded-xl text-base font-medium text-earth-900 hover:bg-sand">Inicio</a>
      <a href="#catalogo" onclick="closeMobileMenu()" class="block px-3 py-2.5 rounded-xl text-base font-medium text-earth-900 hover:bg-sand">Catálogo de Productos</a>
      <a href="#nosotros" onclick="closeMobileMenu()" class="block px-3 py-2.5 rounded-xl text-base font-medium text-earth-900 hover:bg-sand">Sobre Nosotros</a>
      <a href="#contacto" onclick="closeMobileMenu()" class="block px-3 py-2.5 rounded-xl text-base font-medium text-earth-900 hover:bg-sand">Contacto</a>
      <div class="pt-2 border-t border-earth-100">
        <button type="button" onclick="closeMobileMenu(); openAdminModal();" class="w-full flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-sm font-semibold text-forest-800 bg-forest-100/80 hover:bg-forest-100 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          <span>Administrar Productos (Local)</span>
        </button>
      </div>
    </div>
  </header>

  <main class="flex-grow">
    <!-- 1. SECCIÓN INICIO (Hero & Propuesta de Valor) -->
    <section id="inicio" class="relative overflow-hidden bg-gradient-to-b from-sand/70 via-cream to-cream py-10 sm:py-16 lg:py-20 border-b border-earth-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Columna de Texto -->
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center gap-2 bg-forest-100/90 text-forest-800 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-medium border border-forest-600/20">
              <span class="w-2 h-2 rounded-full bg-forest-600"></span>
              <span>Santa Cruz de la Sierra, Bolivia</span>
            </div>

            <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-earth-900 leading-tight">
              Contigo Todo es Natural: productos naturales y artesanales
            </h1>

            <p class="text-base sm:text-lg text-earth-600 leading-relaxed max-w-2xl">
              Explora una selección pensada para quienes valoran lo natural y hecho con dedicación. Arma tu lista de pedido en bolivianos (Bs) y coordina tu compra de forma directa, rápida y personalizada a través de nuestro canal oficial de WhatsApp.
            </p>

            <!-- Botones Principales CTA -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
              <a href="#catalogo" class="inline-flex items-center justify-center gap-2 bg-forest-700 hover:bg-forest-800 text-white font-semibold px-6 py-3.5 rounded-xl shadow-sm transition text-center">
                <span>Ver productos</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </a>
              <a href="https://wa.me/59162303765?text=Hola%20Contigo%20Todo%20es%20Natural%2C%20me%20gustar%C3%ADa%20recibir%20informaci%C3%B3n%20sobre%20sus%20productos." target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2.5 bg-white hover:bg-sand text-forest-800 font-semibold px-6 py-3.5 rounded-xl border-2 border-forest-700/25 shadow-sm transition text-center">
                <svg class="w-5 h-5 text-forest-700 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z"/>
                </svg>
                <span>Comprar por WhatsApp</span>
              </a>
            </div>

            <!-- Propuesta de Valor (3 Pilares Claros sin promesas inventadas) -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-earth-200/70">
              <div class="flex items-start gap-3">
                <div class="p-2 rounded-lg bg-forest-100 text-forest-700 shrink-0" aria-hidden="true">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                  </svg>
                </div>
                <div>
                  <h2 class="text-sm font-semibold text-earth-900">Enfoque Natural</h2>
                  <p class="text-xs text-earth-600 mt-0.5">Productos naturales y artesanales seleccionados.</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="p-2 rounded-lg bg-forest-100 text-forest-700 shrink-0" aria-hidden="true">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                  </svg>
                </div>
                <div>
                  <h2 class="text-sm font-semibold text-earth-900">Atención Directa</h2>
                  <p class="text-xs text-earth-600 mt-0.5">Coordinación personalizada vía WhatsApp.</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="p-2 rounded-lg bg-forest-100 text-forest-700 shrink-0" aria-hidden="true">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <h2 class="text-sm font-semibold text-earth-900">Cotización Clara</h2>
                  <p class="text-xs text-earth-600 mt-0.5">Calcula tu pedido en Bs antes de escribirnos.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Columna de Imagen Principal -->
          <div class="lg:col-span-5">
            <div class="relative rounded-3xl overflow-hidden shadow-xl border-4 border-white bg-sand aspect-[4/3]">
              <img
                src="https://images.unsplash.com/photo-1608571423902-eed4a5ad8108?auto=format&fit=crop&w=900&q=80"
                alt="Presentación ilustrativa de elementos naturales y artesanales en tonos tierra y verde"
                onerror="this.onerror=null; this.src='https://placehold.co/800x600/E7DFD3/2D4F3E?text=Contigo+Todo+es+Natural';"
                class="w-full h-full object-cover"
              />
              <div class="absolute bottom-3 left-3 right-3 bg-cream/95 backdrop-blur-sm px-4 py-2.5 rounded-2xl border border-earth-200/80 flex items-center justify-between text-xs">
                <span class="font-medium text-earth-800">Imagen referencial de estilo natural</span>
                <span class="text-forest-700 font-semibold">Bs · Bolivia</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Aviso de Transparencia sobre Datos de Demostración -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      <div id="demo-notice-banner" class="bg-amber-50/90 border border-amber-300/80 rounded-2xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-sm">
        <div class="flex items-start gap-3">
          <span class="p-2 bg-amber-100 text-amber-800 rounded-xl shrink-0 mt-0.5" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </span>
          <div class="text-sm text-amber-950">
            <p class="font-semibold">Catálogo con registros de DEMOSTRACIÓN editables</p>
            <p class="text-amber-900/90 mt-0.5">
              Los productos, categorías y precios mostrados inicialmente son ejemplos ilustrativos para visualizar la tienda. Puedes editarlos, reemplazarlos o agregar tu inventario real desde el botón <strong>Administrar</strong>.
            </p>
          </div>
        </div>
        <button type="button" onclick="openAdminModal()" class="shrink-0 bg-amber-800 hover:bg-amber-900 text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition cursor-pointer">
          Personalizar inventario
        </button>
      </div>
    </div>

    <!-- 2, 3, 4. SECCIÓN CATÁLOGO, CATEGORÍAS, BUSCADOR Y FILTROS -->
    <section id="catalogo" class="py-10 sm:py-14 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-terracotta-600">Explora y cotiza</span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-earth-900 mt-1">Catálogo de Productos</h2>
          <p class="text-sm text-earth-600 mt-1">Selecciona artículos para calcular tu pedido en bolivianos (Bs) o consulta directamente por WhatsApp.</p>
        </div>
        <div class="text-sm text-earth-600 font-medium" id="results-counter" aria-live="polite">
          Mostrando productos...
        </div>
      </div>

      <!-- Barra de Categorías (Editables) -->
      <div class="mb-6">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-earth-600">Categorías (editables)</span>
          <button type="button" onclick="openAdminModal('categories')" class="text-xs font-medium text-forest-700 hover:underline cursor-pointer">
            + Editar categorías
          </button>
        </div>
        <div id="category-pills" class="flex flex-wrap gap-2" role="tablist" aria-label="Filtrar por categoría">
          <!-- Generado dinámicamente por JS -->
        </div>
      </div>

      <!-- Panel de Buscador y Filtros Avanzados -->
      <div class="bg-white rounded-2xl p-4 sm:p-5 border border-earth-200/80 shadow-sm mb-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-4 items-end">
          
          <!-- Buscador por Nombre -->
          <div class="lg:col-span-4">
            <label for="search-input" class="block text-xs font-semibold text-earth-800 mb-1.5">Buscar producto</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-earth-600 pointer-events-none" aria-hidden="true">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </span>
              <input
                type="search"
                id="search-input"
                placeholder="Ej. jabón, miel, infusión..."
                class="w-full pl-10 pr-4 py-2.5 bg-cream/60 border border-earth-200 rounded-xl text-sm text-earth-900 placeholder-earth-600/60 focus:outline-none focus:ring-2 focus:ring-forest-700 focus:border-forest-700 transition"
              />
            </div>
          </div>

          <!-- Filtro Categoría (Select sincronizado) -->
          <div class="lg:col-span-3">
            <label for="category-select" class="block text-xs font-semibold text-earth-800 mb-1.5">Categoría</label>
            <select
              id="category-select"
              class="w-full px-3.5 py-2.5 bg-cream/60 border border-earth-200 rounded-xl text-sm text-earth-900 focus:outline-none focus:ring-2 focus:ring-forest-700 focus:border-forest-700 transition"
            >
              <!-- Generado dinámicamente -->
            </select>
          </div>

          <!-- Rango de Precios (Mín y Máx en Bs) -->
          <div class="lg:col-span-3">
            <span class="block text-xs font-semibold text-earth-800 mb-1.5">Rango de precio (Bs)</span>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label for="min-price" class="sr-only">Precio mínimo en Bs</label>
                <input
                  type="number"
                  id="min-price"
                  min="0"
                  step="1"
                  placeholder="Mín Bs"
                  class="w-full px-3 py-2.5 bg-cream/60 border border-earth-200 rounded-xl text-sm text-earth-900 placeholder-earth-600/60 focus:outline-none focus:ring-2 focus:ring-forest-700"
                />
              </div>
              <div>
                <label for="max-price" class="sr-only">Precio máximo en Bs</label>
                <input
                  type="number"
                  id="max-price"
                  min="0"
                  step="1"
                  placeholder="Máx Bs"
                  class="w-full px-3 py-2.5 bg-cream/60 border border-earth-200 rounded-xl text-sm text-earth-900 placeholder-earth-600/60 focus:outline-none focus:ring-2 focus:ring-forest-700"
                />
              </div>
            </div>
          </div>

          <!-- Filtro Disponibilidad + Limpiar -->
          <div class="lg:col-span-2 flex items-center gap-2">
            <button
              type="button"
              onclick="resetFilters()"
              class="w-full py-2.5 px-4 bg-sand hover:bg-earth-200/70 text-earth-800 font-medium text-sm rounded-xl border border-earth-200 transition cursor-pointer"
            >
              Limpiar filtros
            </button>
          </div>

        </div>
      </div>

      <!-- Cuadrícula de Productos -->
      <div id="products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Tarjetas de productos renderizadas por JS -->
      </div>

      <!-- Estado Vacío cuando no hay coincidencias -->
      <div id="empty-state" class="hidden bg-white rounded-3xl border border-earth-200 p-10 text-center max-w-lg mx-auto my-6">
        <div class="w-14 h-14 bg-sand text-earth-600 rounded-2xl flex items-center justify-center mx-auto mb-4" aria-hidden="true">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <h3 class="font-serif text-xl font-bold text-earth-900">No encontramos productos con esos filtros</h3>
        <p class="text-sm text-earth-600 mt-2">Intenta ajustar el rango de precios, cambiar de categoría o borrar el texto de búsqueda.</p>
        <button type="button" onclick="resetFilters()" class="mt-5 inline-flex items-center gap-2 bg-forest-700 hover:bg-forest-800 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition cursor-pointer">
          Mostrar todos los productos
        </button>
      </div>
    </section>

    <!-- 8. SECCIÓN SOBRE NOSOTROS (Honesta, sin historia inventada ni propiedades medicinales) -->
    <section id="nosotros" class="py-12 sm:py-16 bg-sand/60 border-y border-earth-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-5 order-2 lg:order-1">
            <div class="rounded-3xl overflow-hidden border-4 border-white shadow-md bg-cream aspect-[4/3]">
              <img
                src="https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?auto=format&fit=crop&w=900&q=80"
                alt="Elementos botánicos y artesanales representativos de Contigo Todo es Natural"
                onerror="this.onerror=null; this.src='https://placehold.co/800x600/F1EAE0/2D4F3E?text=Sobre+Nosotros';"
                class="w-full h-full object-cover"
              />
            </div>
          </div>

          <div class="lg:col-span-7 order-1 lg:order-2 space-y-5">
            <span class="text-xs font-bold uppercase tracking-widest text-terracotta-600">Sobre Nosotros</span>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-earth-900">
              Cercanía y selección natural en Santa Cruz de la Sierra
            </h2>
            <p class="text-base text-earth-800 leading-relaxed">
              <strong>Contigo Todo es Natural</strong> es un emprendimiento ubicado en <strong>Santa Cruz de la Sierra, Bolivia</strong>, dedicado a la comercialización de productos naturales y artesanales.
            </p>
            <p class="text-base text-earth-600 leading-relaxed">
              Nuestro enfoque se centra en brindar una experiencia de compra transparente, cercana y sencilla: puedes explorar las opciones disponibles en nuestro catálogo digital, consultar detalles específicos y coordinar directamente cada pedido a través de nuestro canal oficial de WhatsApp.
            </p>
            <div class="pt-2 flex flex-wrap gap-3">
              <span class="inline-flex items-center gap-2 bg-white px-4 py-2 rounded-xl border border-earth-200 text-xs sm:text-sm font-medium text-earth-800">
                <svg class="w-4 h-4 text-forest-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                Productos naturales y artesanales
              </span>
              <span class="inline-flex items-center gap-2 bg-white px-4 py-2 rounded-xl border border-earth-200 text-xs sm:text-sm font-medium text-earth-800">
                <svg class="w-4 h-4 text-forest-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                Atención directa por WhatsApp
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 9. SECCIÓN CONTACTO (Redirección real a WhatsApp, sin simular envío a servidor) -->
    <section id="contacto" class="py-12 sm:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        
        <!-- Datos Oficiales -->
        <div class="lg:col-span-5 space-y-6">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-terracotta-600">Canal Directo</span>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-earth-900 mt-1">Contacto</h2>
            <p class="text-sm sm:text-base text-earth-600 mt-2">
              ¿Tienes dudas sobre disponibilidad, presentaciones o entregas en Santa Cruz? Escríbenos directamente a nuestro WhatsApp oficial.
            </p>
          </div>

          <div class="space-y-4">
            <div class="bg-white p-4 rounded-2xl border border-earth-200/80 flex items-start gap-4">
              <div class="p-3 rounded-xl bg-forest-100 text-forest-700 shrink-0" aria-hidden="true">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-bold text-earth-900">WhatsApp Oficial</h3>
                <p class="text-sm text-earth-600 mt-0.5">+591 62303765</p>
                <a href="https://wa.me/59162303765?text=Hola%20Contigo%20Todo%20es%20Natural%2C%20quisiera%20hacer%20una%20consulta." target="_blank" rel="noopener noreferrer" class="inline-block mt-2 text-xs font-semibold text-forest-700 hover:text-forest-800 underline">
                  Abrir chat directo &rarr;
                </a>
              </div>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-earth-200/80 flex items-start gap-4">
              <div class="p-3 rounded-xl bg-sand text-earth-800 shrink-0" aria-hidden="true">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-bold text-earth-900">Ubicación</h3>
                <p class="text-sm text-earth-600 mt-0.5">Santa Cruz de la Sierra, Bolivia</p>
                <p class="text-xs text-earth-600 mt-1">Coordinamos puntos de entrega y envíos locales por chat.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Formulario que prepara mensaje y redirige a WhatsApp -->
        <div class="lg:col-span-7">
          <form id="contact-form" onsubmit="handleContactSubmit(event)" class="bg-white p-6 sm:p-8 rounded-3xl border border-earth-200/90 shadow-sm space-y-5" novalidate>
            <div class="border-b border-earth-100 pb-4">
              <h3 class="font-serif text-xl font-bold text-earth-900">Envíanos tu consulta por WhatsApp</h3>
              <p class="text-xs text-earth-600 mt-1">
                Este formulario prepara tu mensaje y abre WhatsApp directamente (+591 62303765). No almacenamos datos en servidores externos.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-xs font-semibold text-earth-800 mb-1.5">Tu nombre *</label>
                <input
                  type="text"
                  id="contact-name"
                  required
                  placeholder="Ej. María Pérez"
                  class="w-full px-4 py-2.5 bg-cream/60 border border-earth-200 rounded-xl text-sm text-earth-900 focus:outline-none focus:ring-2 focus:ring-forest-700"
                />
              </div>

              <div>
                <label for="contact-topic" class="block text-xs font-semibold text-earth-800 mb-1.5">Motivo de consulta</label>
                <select
                  id="contact-topic"
                  class="w-full px-4 py-2.5 bg-cream/60 border border-earth-200 rounded-xl text-sm text-earth-900 focus:outline-none focus:ring-2 focus:ring-forest-700"
                >
                  <option value="Consulta sobre disponibilidad de productos">Disponibilidad de productos</option>
                  <option value="Consulta sobre entregas en Santa Cruz">Entregas en Santa Cruz de la Sierra</option>
                  <option value="Pedido personalizado">Pedido personalizado</option>
                  <option value="Otra consulta">Otra consulta</option>
                </select>
              </div>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-semibold text-earth-800 mb-1.5">Mensaje *</label>
              <textarea
                id="contact-message"
                rows="3"
                required
                placeholder="Escribe aquí tu consulta..."
                class="w-full px-4 py-2.5 bg-cream/60 border border-earth-200 rounded-xl text-sm text-earth-900 focus:outline-none focus:ring-2 focus:ring-forest-700"
              ></textarea>
            </div>

            <p id="contact-error" class="hidden text-xs font-medium text-red-700 bg-red-50 border border-red-200 px-3.5 py-2 rounded-xl" role="alert"></p>

            <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-forest-700 hover:bg-forest-800 text-white font-semibold px-6 py-3.5 rounded-xl shadow-sm transition cursor-pointer">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z"/>
              </svg>
              <span>Continuar en WhatsApp</span>
            </button>
          </form>
        </div>

      </div>
    </section>
  </main>

  <!-- Pie de Página -->
