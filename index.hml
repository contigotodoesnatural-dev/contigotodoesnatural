      <div>
        <p class="font-serif text-xl font-bold text-white">Contigo Todo es Natural</p>
        <p class="text-sm text-earth-200/80 mt-1">Productos naturales y artesanales · Santa Cruz de la Sierra, Bolivia</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="https://wa.me/59162303765" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-forest-700 hover:bg-forest-600 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition">
